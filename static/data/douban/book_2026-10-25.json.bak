      ],
      "book_subtitle": "开启自我改变的原动力",
      "buy_more_uri": "douban://douban.com/book/35193035/vendors_douban",
      "card_subtitle": "周岭 / 2020 / 人民邮电出版社",
      "color_scheme": {
