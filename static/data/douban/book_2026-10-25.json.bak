      "article_intros": [],
      "author": [
        "[美] 菲利普·迪克"
      ],
      "book_subtitle": "",
      "buy_more_uri": "douban://douban.com/book/27041533/vendors_douban",
      "card_subtitle": "[美] 菲利普·迪克 / 2017 / 译林出版社",
      "color_scheme": {
        "_base_color": [
          0.01607445008460238,
          0.8914027149321267,
